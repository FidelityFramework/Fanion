query-response ::= "{" ws pgq-fields ws "}"
pgq-fields ::= (fields-chunks-range | fields-filtered | fields-self | fields-plain | fields-shortest)
fields-filtered ::= "\"query\"" ws ":" ws query-filtered ws "," ws "\"parameters\"" ws ":" ws parameters-filtered
fields-chunks-range ::= "\"query\"" ws ":" ws query-chunks-range ws "," ws "\"parameters\"" ws ":" ws parameters-chunks
parameters-chunks ::= "{" ws "\"seed\"" ws ":" ws seed ws "," ws "\"edge_kind\"" ws ":" ws "\"chunks_of\"" ws "}"
fields-self ::= "\"query\"" ws ":" ws query-self ws "," ws "\"parameters\"" ws ":" ws parameters-plain
fields-plain ::= "\"query\"" ws ":" ws query-plain ws "," ws "\"parameters\"" ws ":" ws parameters-plain
fields-shortest ::= "\"query\"" ws ":" ws query-shortest ws "," ws "\"parameters\"" ws ":" ws parameters-plain
parameters-plain ::= "{" ws "\"seed\"" ws ":" ws seed ws "}"
parameters-filtered ::= "{" ws "\"seed\"" ws ":" ws seed ws "," ws "\"edge_kind\"" ws ":" ws edge-kind ws "}"
query-self ::= "\"MATCH (a:resource WHERE a.id = $seed) COLUMNS (a.id)\""
query-filtered ::= "\"" ("MATCH (a:resource WHERE a.id = $seed)-[e:relation WHERE e.kind = $edge_kind]->(b:resource) COLUMNS (" | "MATCH (a:resource WHERE a.id = $seed)<-[e:relation WHERE e.kind = $edge_kind]-(b:resource) COLUMNS (") node-columns edge-columns ")\""
query-plain ::= "\"" ("MATCH (a:resource WHERE a.id = $seed)-[e:relation]->(b:resource) COLUMNS (" | "MATCH (a:resource WHERE a.id = $seed)<-[e:relation]-(b:resource) COLUMNS (") node-columns edge-columns ")\""
query-chunks-range ::= "\"MATCH (a:resource WHERE a.id = $seed)<-[e:relation WHERE e.kind = $edge_kind]-(b:resource WHERE b.line_start <= " line-number " AND b.line_end >= " line-number ") COLUMNS (" node-columns edge-columns ")\""
line-number ::= [1-9] [0-9]{0,8} | "1" [0-9]{9} | "20" [0-9]{8} | "21" [0-3] [0-9]{7} | "214" [0-6] [0-9]{6} | "2147" [0-3] [0-9]{5} | "21474" [0-7] [0-9]{4} | "214748" [0-2] [0-9]{3} | "2147483" [0-5] [0-9]{2} | "21474836" [0-3] [0-9] | "214748364" [0-7]
query-shortest ::= "\"MATCH p = ANY SHORTEST (a:resource WHERE a.id = $seed)-[e:relation]->{1," [1-4] "}(b:resource) COLUMNS (" node-columns (", path_length(p)")? ")\""
node-columns ::= "b.id" (", b.repo")? (", b.revision")? (", b.path")? (", b.kind")? (", b.title")? (", b.line_start")? (", b.line_end")? (", b.source_url")? (", b.corpus_layer")? (", b.classification_rule")?
edge-columns ::= (", e.kind")? (", e.basis")? (", e.confidence")? (", e.evidence_id")? (", e.evidence_line_start")? (", e.evidence_line_end")? (", e.rule")? (", e.explanation")?
edge-kind ::= "\"chunks_of\"" | "\"contains\"" | "\"declares_capability\"" | "\"generated_by\"" | "\"generated_from\"" | "\"links_to\"" | "\"mentions\"" | "\"references_project\"" | "\"shares_capability\"" | "\"suggests_capability\""
seed ::= hex64-string
hex64-string ::= "\"" [0-9a-f]{64} "\""
ws ::= [ \t\n\r]{0,4}
